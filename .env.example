# Configuración de la base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=laboratorios

# Configuración del servidor
PORT=3000
NODE_ENV=development

# Configuración de JWT
JWT_SECRET=tu_jwt_secret_aqui

# Logging (opcional)
# LOG_LEVEL=warn
# BetterStack (opcional, no definitivo): si LOGTAIL_SOURCE_TOKEN está definido, los logs se envían además a BetterStack
# LOGTAIL_SOURCE_TOKEN=
# LOGTAIL_ENDPOINT=

# Variables para Railway (producción)
# Estas variables se configuran automáticamente en Railway
# DB_HOST=containers-us-west-XX.railway.app
# DB_PORT=XXXXX
# DB_USER=root
# DB_PASSWORD=tu_password_de_railway
# DB_NAME=railway

# Pruebas: con NODE_ENV=test se carga .env.test (ver server/config/env.js)
# Crear .env.test a partir de este archivo usando DB_NAME=laboratorios_test (o similar)
